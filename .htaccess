<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Automatically resolve /api/<endpoint> to /api/<endpoint>.php if .php file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^(api/.*)$ $1.php [L,QSA]

  # Do not rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>
